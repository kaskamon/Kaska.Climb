{
  "crons": [
    {
      "path": "/api/listar-clientes?accion=revisar-caducados",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/listar-clientes?accion=backup-diario",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "functions": {
    "api/listar-clientes.js": {
      "maxDuration": 30
    }
  }
}
